pragma language_version 0.23;

import CompactStandardLibrary;

// Where hello-world stores a message publicly, this contract keeps the message
// private and publishes only its hash. Anyone can verify a guessed message by
// re-hashing it and comparing, but the on-chain state never reveals the text.

// The public commitment: the hash of the caller's secret message.
export ledger messageHash: Bytes<32>;

// Supplies the secret message from the caller's private state, encoded as bytes.
// The plaintext lives off-chain; the witness (see witnesses.ts) turns it into the
// 32-byte value the circuit hashes. Its value never leaves the local prover —
// only the hash derived from it is disclosed on-chain.
// This is the users first introduction to witness functions
witness secretMessage(): Bytes<32>;

// 1. Reads the secret message from private state and publishes its hash. The bytes
// themselves are never written to the ledger.
export circuit publishMessageHash(): [] {
  const secret = secretMessage();
  messageHash = disclose(hashMessage(secret));
}

// 2. But couldn't someone guess this message?
export circuit publishMessageHashWithSeparator(): [] {
  const secret = secretMessage();
  messageHash = disclose(hashMessageWithSeparator(secret));
}

// 3. What if there are many instances of the contract?
export circuit publishMessageWithSeparator(): [] {
  const secret = secretMessage();
  messageHash = disclose(hashMessageWithDynamicSeparator(secret));
}

// 1. Takes the message in through a parameter and returns its hash. Exported so a
// verifier can recompute the hash from a guessed message off-chain and compare it
// to `messageHash` — the standard way to check a hash commitment. `disclose` is
// required because, when called from `publishMessageHash`, the argument is a
// witness value about to cross the privacy boundary onto the public ledger.
export circuit hashMessage(_message: Bytes<32>): Bytes<32> {
  return persistentHash<Bytes<32>>(_message);
}

// 2. These are one-way deterministic hashes, so the same message always produces the
// same hash. Wouldn't it be possible to have hashes collide?
// solution: domain-separation
export circuit hashMessageWithSeparator(_message: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "secret-message:msg:"), _message]);
}

// 3. What if you are deploying many instances of this contract?
// solution: the domain-separator needs a dynamic contract representation
// NOTE: kernel.self() resolves to the contract address, but not until after
// the constructor executes. During the constructor execution, there is no
// contract address, so kernel.self() resolves differently during the constructor.
// If you call this function in the constructor, it will not work.
// The hash itself is pure: it takes the separating address as a parameter, so an
// off-chain verifier can recompute it for a known contract address.
export circuit hashMessageWithAddress(_address: Bytes<32>, _message: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([_address, _message]);
}

// Only this wrapper is impure — reading kernel.self() is what costs a circuit.
circuit hashMessageWithDynamicSeparator(_message: Bytes<32>): Bytes<32> {
  return hashMessageWithAddress(kernel.self().bytes, _message);
}

// 4. What if we wanted the message to have an owner? 
// Right now, there is no access control on the exported circuits. This means 
// that they can be called by anyone. What if we want the owner and only the owner
// to be able to take the message down?

export ledger messageOwner: Bytes<32>;

export circuit publishMessageHashWithOwner(_ownerSecretKey: Bytes<32>): [] {
  const secret = secretMessage();
  const pubKey = getDappPubKey(_ownerSecretKey);
  assert(messageOwner == default<Bytes<32>> || messageOwner == disclose(pubKey), "You are not the owner of this message");
  messageOwner = disclose(pubKey);
  messageHash = disclose(hashMessageWithDynamicSeparator(secret));
}

export circuit getDappPubKey(_ownerSecretKey: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "secret-message:pk:"), _ownerSecretKey]);
}

export circuit removeMessageHash(_ownerSecretKey: Bytes<32>): [] {
  const pubKey = getDappPubKey(_ownerSecretKey);
  assert(messageOwner == disclose(pubKey), "You are not the owner of this message");
  messageHash = default<Bytes<32>>;// set the string to empty
  messageOwner = default<Bytes<32>>;// set the owner to empty
}

// Notice that secretMessage() is a witness call, but the _secretKeys are also
// passed in as circuit parameters. Both of these approaches is safe to maintain
// the privacy of the data in question. The witness function returns here could
// just as safely be included in the circuit parameter.

