{
  "name": "mn-examples",
  "version": "0.1.0",
  "private": true,
  "description": "Official Midnight example DApps and smart contracts, verified to compile and run against a pinned toolchain.",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "examples/*",
    "examples/*/ui",
    "packages/*"
  ],
  "scripts": {
    "new:example": "node scripts/new-example.mjs",
    "new:ui": "node scripts/new-ui.mjs",
    "wallets:new": "yarn workspace @midnight-ntwrk/example-fast-sync run wallets:new",
    "preseed:cut": "yarn workspace @midnight-ntwrk/example-fast-sync run preseed:cut",
    "compile": "yarn workspaces foreach --all --parallel run compile",
    "test": "yarn workspaces foreach --all --verbose run test",
    "test:local": "yarn workspaces foreach --all --verbose run test:local",
    "test:preprod": "yarn workspaces foreach --all --verbose run test:preprod",
    "test:preview": "yarn workspaces foreach --all --verbose run test:preview"
  },
  "devDependencies": {
    "bn.js": "5.2.5"
  },
  "resolutions": {
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/ledger-v8": "8.1.2",
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.1",
    "@midnight-ntwrk/zkir-v2": "2.1.1",
    "vite-plugin-top-level-await/@swc/core": "1.15.47"
  }
}
