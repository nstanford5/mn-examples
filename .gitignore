# Dependencies
node_modules/

# Yarn Berry (node-modules linker): keep releases, ignore install state
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Build / TypeScript output
dist/

# Generated compiled-contract output (regenerated by `yarn compile`).
# NOTE: the .compact SOURCE files are committed on purpose — do not ignore them.
**/contract/managed/
**/contracts/managed/

# Local runtime state and secrets (never commit real env files)
**/logs/
**/midnight-level-db/
**/.env.preprod
**/.env.preview
**/.fast-sync-wallets/

# OS / editor
.DS_Store
*.log
